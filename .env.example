# Copy this file to .env and change the values. Never commit .env.

# MODE=single (default): your own copy with one owner, set below.
# MODE=hosted: a public website where anyone signs up with an email and a password (README: "Run the public website").
MODE=single

# single mode: owner sign-in for dev mode (/admin). The password must have at least 8 characters.
ADMIN_USERNAME=owner
ADMIN_PASSWORD=change-me-to-a-long-password

# hosted mode only
# ADMIN_EMAIL=you@example.com     # this account sets the landing page look
# CLIENT_IP_HEADER=Fly-Client-IP  # Fly.io: Fly-Client-IP, Railway: X-Real-IP, Caddy: X-Forwarded-For
# UPLOAD_LIMIT_MB=100             # uploads per account

# Optional
PORT=4200
DATABASE_PATH=data/feedbacker.db
