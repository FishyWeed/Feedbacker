# Copy this file to .env and change the values. Never commit .env. Every setting is optional.
# People make their own account at /admin/signup (email and password); each account sees only its own forms.

# Your account's email. It sets the landing page look, and it gets the forms from older versions (one owner from .env).
# Without it, the first account on the server sets the landing page look.
# ADMIN_EMAIL=you@example.com

# "closed" stops new accounts (existing accounts still sign in). Close it after you make your own account if the
# server is only for you or your team.
# SIGNUP=open

# Behind a proxy: the header that holds the visitor's address.
# Fly.io: Fly-Client-IP. Railway: X-Real-IP. Caddy: X-Forwarded-For.
# CLIENT_IP_HEADER=X-Forwarded-For

# Storage for uploaded images and videos, per account.
# UPLOAD_LIMIT_MB=100

PORT=4200
DATABASE_PATH=data/feedbacker.db
